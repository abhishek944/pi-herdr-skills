{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "debugLog": false,
  "permissionReviewLog": true,
  "yoloMode": false,
  "doublePressToConfirm": true,
  "authorizerChain": [],
  "shellTools": {
    "MonitorCreate": {
      "commandArgument": "command"
    }
  },
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow"
    },
    "path_read": {
      "*": "allow",
      ".env": "ask",
      ".env.*": "ask",
      "*/.env": "ask",
      "*/.env.*": "ask",
      "*.pem": "ask",
      "*.key": "ask",
      "~/.ssh/*": "ask",
      "~/.aws/*": "ask",
      "~/.gnupg/*": "ask",
      "~/.kube/*": "ask",
      "~/.docker/*": "ask",
      "~/Library/Keychains/*": "ask"
    },
    "path_write": {
      "*": "allow",
      ".git": "ask",
      ".git/*": "ask",
      "*/.git": "ask",
      "*/.git/*": "ask",
      ".env": "ask",
      ".env.*": "ask",
      "*/.env": "ask",
      "*/.env.*": "ask",
      "*.pem": "ask",
      "*.key": "ask",
      "~/.ssh/*": "ask",
      "~/.aws/*": "ask",
      "~/.gnupg/*": "ask",
      "~/.kube/*": "ask",
      "~/.docker/*": "ask",
      "~/Library/Keychains/*": "ask"
    },
    "external_directory_read": "allow",
    "external_directory_write": {
      "*": "ask",
      "~/.agents/*": "allow",
      "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome": "allow",
      "/Applications/Godot.app/Contents/MacOS/Godot": "allow",
      "/tmp/*": "allow",
      "/private/tmp/*": "allow",
      "/var/*": "allow",
      "/private/var/*": "allow",
      "~/.pi/*": "allow",
      "~/Library/Application Support/com.raycast.macos/clipboard/*": "allow"
    },
    "bash": {
      "*": "allow",
      "rmdir *": "ask",
      "unlink *": "ask",
      "shred *": "ask",
      "find *-delete*": "ask",
      "install *": "ask",
      "truncate *": "ask",
      "chown *": "ask",
      "sudo *": "ask",
      "su *": "ask",
      "doas *": "ask",
      "pkexec *": "ask",
      "runuser *": "ask",
      "setpriv *": "ask",
      "chroot *": "ask",
      "git reset *": "ask",
      "git clean *": "ask",
      "git restore *": "ask",
      "git checkout -- *": "ask",
      "git branch -d*": "ask",
      "git branch -D*": "ask",
      "git tag -d*": "ask",
      "git rm *": "ask",
      "git stash drop*": "ask",
      "git stash clear*": "ask",
      "git worktree remove*": "ask",
      "git push *--delete*": "ask",
      "git remote remove*": "ask",
      "git reflog expire*": "ask",
      "git gc *--prune*": "ask",
      "git prune*": "ask",
      "npm publish*": "ask",
      "npm unpublish*": "ask",
      "npm deprecate*": "ask",
      "npm uninstall*": "ask",
      "npm remove*": "ask",
      "pnpm publish*": "ask",
      "pnpm unpublish*": "ask",
      "pnpm remove*": "ask",
      "pnpm uninstall*": "ask",
      "yarn publish*": "ask",
      "yarn npm unpublish*": "ask",
      "yarn npm publish*": "ask",
      "yarn remove*": "ask",
      "bun publish*": "ask",
      "bun remove*": "ask",
      "cargo publish*": "ask",
      "gem push*": "ask",
      "docker system prune*": "ask",
      "docker volume rm*": "ask",
      "docker volume prune*": "ask",
      "docker image rm*": "ask",
      "docker container rm*": "ask",
      "docker rm *": "ask",
      "docker compose down*": "ask",
      "terraform destroy*": "ask",
      "tofu destroy*": "ask",
      "kubectl delete*": "ask",
      "helm uninstall*": "ask",
      "gh repo delete*": "ask",
      "gh release delete*": "ask",
      "mkfs*": "ask",
      "wipefs*": "ask",
      "fdisk *": "ask",
      "parted *": "ask",
      "diskutil *erase*": "ask",
      "diskutil *partition*": "ask",
      "dd *of=/dev/*": "ask",
      "shutdown*": "ask",
      "reboot*": "ask",
      "halt*": "ask",
      "poweroff*": "ask",
      "eval *": "ask",
      "source *": "ask",
      ". *": "ask",
      "bash -c *": "ask",
      "bash -lc *": "ask",
      "sh -c *": "ask",
      "sh -lc *": "ask",
      "zsh -c *": "ask",
      "zsh -lc *": "ask",
      "dash -c *": "ask",
      "ksh -c *": "ask",
      ": *": "ask",
      "wget *": "ask"
    }
  }
}
